
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  duration     Int
  price        Int
  deposit      Int
  isActive     Boolean       @default(true)
  displayOrder Int           @default(0)
  appointments Appointment[]
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @updatedAt
}

model Client {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  phone          String
  allergies      String?
  referralSource String?
  noShowCount    Int           @default(0)
  isFlagged      Boolean       @default(false)
  appointments   Appointment[]
  createdAt      DateTime @db.Timestamptz(3) @default(now())
  updatedAt      DateTime @db.Timestamptz(3) @updatedAt
}

model Appointment {
  id                    String            @id @default(cuid())
  client                Client            @relation(fields: [clientId], references: [id])
  clientId              String
  service               Service           @relation(fields: [serviceId], references: [id])
  serviceId             String
  startsAt              DateTime @db.Timestamptz(3)
  endsAt                DateTime @db.Timestamptz(3)
  status                AppointmentStatus @default(CONFIRMED)
  depositAmount         Int
  depositStatus         DepositStatus     @default(HELD)
  stripePaymentIntentId String?           @unique
  idempotencyKey        String?           @unique
  manageToken           String            @unique
  policyAgreedAt        DateTime? @db.Timestamptz(3)
  cancellationReason    String?
  cancelledAt           DateTime? @db.Timestamptz(3)
  noShowMarkedAt        DateTime? @db.Timestamptz(3)
  reminder24hSentAt     DateTime? @db.Timestamptz(3)
  reminder2hSentAt      DateTime? @db.Timestamptz(3)
  ownerNotes            String?
  createdAt             DateTime @db.Timestamptz(3) @default(now())
  updatedAt             DateTime @db.Timestamptz(3) @updatedAt
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  HELD
  REFUNDED
  CREDITED
  FORFEITED
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @db.Timestamptz(3) @default(now())
}

model WeeklyAvailability {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
}

model OwnerSession {
  id        String   @id @default(cuid())
  createdAt DateTime @db.Timestamptz(3) @default(now())
}

model SlotHold {
  id        String   @id @default(cuid())
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@unique([startsAt])
}
